#!/usr/bin/env bash
# Copy outside this repository as config/profile.env, mode 600.
# Replace every REPLACE_* value. Never put passwords or tokens in this file.
export OFFSITE_ROOT='/mnt/user/REPLACE_PRIVATE_SHARE/offsite/production'
export OFFSITE_SOURCE='/mnt/user/appdata/database-backup/backups'
export OFFSITE_JOBS='/mnt/user/appdata/database-backup/backups.yml'
export OFFSITE_NETWORK='REPLACE_EXISTING_DOCKER_NETWORK'
export OFFSITE_IMAGE='unraid-database-offsite:local'
# From the init output. Used only to confirm retention, not as a password.
export OFFSITE_REPOSITORY_ID='REPLACE_WITH_64_HEX_REPOSITORY_ID'
